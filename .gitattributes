# Normalise text files in the repository, check out with native line endings.
* text=auto

# Windows-native tooling requires CRLF on disk.
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.iss   text eol=crlf

# Shell scripts must stay LF even on Windows checkouts.
*.sh    text eol=lf

# Sources
*.c     text diff=cpp
*.h     text diff=cpp
*.cpp   text diff=cpp
*.hpp   text diff=cpp
*.cmake text
CMakeLists.txt text
*.md    text diff=markdown
*.yml   text
*.yaml  text
*.json  text

# Inno Setup message files are UTF-16/UTF-8-BOM resources; never munge them.
*.isl   -text

# Binary assets
*.ico   binary
*.png   binary
*.bmp   binary
*.zip   binary
*.exe   binary
