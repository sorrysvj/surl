{
  "name": "surl",
  "version": "1.0.0",
  "description": "CLI tool for local website mirroring",
  "main": "dist/index.js",
  "bin": {
    "surl": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && node scripts/add-shebang.js",
    "build:exe": "npm run build && npx @yao-pkg/pkg dist/index.js --targets node20-win-x64 --output bin/surl.exe",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "website",
    "mirror",
    "download",
    "crawler",
    "scraper",
    "cli",
    "offline",
    "archive"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/user/surl.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "cheerio": "^1.0.0-rc.12",
    "cli-progress": "^3.12.0",
    "commander": "^11.1.0",
    "css-tree": "^2.3.1",
    "ora": "^7.0.1",
    "p-limit": "^5.0.0",
    "undici": "^6.6.2"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.5",
    "@types/css-tree": "^2.3.5",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitest/coverage-v8": "^1.2.1",
    "@yao-pkg/pkg": "^6.22.0",
    "eslint": "^8.56.0",
    "pkg": "^5.8.1",
    "prettier": "^3.2.4",
    "rimraf": "^5.0.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.1"
  },
  "pkg": {
    "assets": [
      "dist/**/*"
    ],
    "outputPath": "bin"
  }
}
